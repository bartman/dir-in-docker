#!/usr/bin/env bash
set -eu

SELF="$(realpath $0)"
SELFDIR="$(dirname "${SELF}")"
SELF="${SELF##*/}"

WORKDIR="$(pwd)"
PROJNAME="$(basename "$WORKDIR")"
TARGET=
XENABLE=false
PERFENABLE=false
NETENABLE=false
REBUILD=false
EXTRA_VOLUMES=( )
EXTRA_PACKAGES=( )
EXPOSE_PORTS=( )

LCL_DOCKERFILE_DIR=$(realpath ${WORKDIR})
SYS_DOCKERFILE_DIR=$(realpath ${SELFDIR}/dockerfiles)

HOSTNAME="$(hostname)"
USERNAME="$(id -u -n)"
USER_UID="$(id -u)"
USER_GID="$(id -g)"

# terminal colors
BLACK='\033[0;30m' RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[0;33m' BLUE='\033[0;34m' MAGENTA='\033[0;35m' CYAN='\033[0;36m' WHITE='\033[0;37m'
BRIGHT_BLACK='\033[1;30m' BRIGHT_RED='\033[1;31m' BRIGHT_GREEN='\033[1;32m' BRIGHT_YELLOW='\033[1;33m' BRIGHT_BLUE='\033[1;34m' BRIGHT_MAGENTA='\033[1;35m' BRIGHT_CYAN='\033[1;36m' BRIGHT_WHITE='\033[1;37m'
RESET='\033[0m'

function die {
    echo -e >&2 "${BRIGHT_RED}ERROR: $*${RESET}"
    exit 1
}

function warn {
    echo -e >&2 "${BRIGHT_YELLOW}WARNING: $*${RESET}"
}

function available_targets {
    declare -A seen=()
    for dir in "$LCL_DOCKERFILE_DIR" "$SYS_DOCKERFILE_DIR" ; do
        [ -d "$dir" ] || continue
        while IFS= read -r filename ; do
            local name="${filename%.Dockerfile}"
            # skip base dockerfiles; they are built as dependencies, not targets
            [[ "$name" == *-base ]] && continue
            [[ -v seen[$name] ]] && continue
            seen[$name]=1
            echo "$name"
        done < <(find "$dir" -maxdepth 1 -name '*.Dockerfile' -printf '%f\n' 2>/dev/null | sort)
    done
}
function default_target {
    available_targets | head -n1
}
function dockerfile_for {
    local target="$1"
    local possible=(
        "$LCL_DOCKERFILE_DIR/${target}.Dockerfile"
        "$SYS_DOCKERFILE_DIR/${target}.Dockerfile"
    )
    for try in "${possible[@]}" ; do
        [ -f "$try" ] || continue
        echo "$try"
        return
    done
}

# Locate NAME-base.Dockerfile for a given target NAME (local overrides system).
function base_dockerfile_for {
    local target="$1"
    local possible=(
        "$LCL_DOCKERFILE_DIR/${target}-base.Dockerfile"
        "$SYS_DOCKERFILE_DIR/${target}-base.Dockerfile"
    )
    for try in "${possible[@]}" ; do
        [ -f "$try" ] || continue
        echo "$try"
        return
    done
}

declare TARGET= DOCKERFILE= FULLNAME=
declare BASE_DOCKERFILE= BASE_FULLNAME=

function derive_target_project_variables {
    [ -z "$TARGET" ] && TARGET="$(default_target)"
    [ -z "$TARGET" ] && die "No targets found; see documentation."
    DOCKERFILE="$(dockerfile_for "$TARGET")"
    [ -f "$DOCKERFILE" ] || die "$DOCKERFILE: no such file"
    [ -r "$DOCKERFILE" ] || die "$DOCKERFILE: cannot be read"
    FULLNAME="DID-${PROJNAME}-for-$USERNAME-on-$TARGET"
    FULLNAME="$(tr 'A-Z' 'a-z' <<<"$FULLNAME")"

    # Optional shared base: NAME-base.Dockerfile -> image did-NAME-base
    BASE_DOCKERFILE="$(base_dockerfile_for "$TARGET" || true)"
    if [ -n "${BASE_DOCKERFILE:-}" ]; then
        BASE_FULLNAME="did-${TARGET}-base"
        BASE_FULLNAME="$(tr 'A-Z' 'a-z' <<<"$BASE_FULLNAME")"
    else
        BASE_DOCKERFILE=
        BASE_FULLNAME=
    fi
}

declare -a BUILD_ARGS=()

function set_build_args {
    local value

    # transfer host user.email to docker
    value="$(git config user.email || true)"
    [ -z "$value" ] && value="$USERNAME@$HOSTNAME"
    [ -n "$value" ] && BUILD_ARGS+=( "--build-arg=GIT_EMAIL=$value" )

    # transfer host user.name to docker
    value="$(git config user.name || true)"
    [ -z "$value" ] && value="$USERNAME"
    [ -n "$value" ] && BUILD_ARGS+=( "--build-arg=GIT_NAME=$value" )

    # Add WORKDIR, UID, GID, and USERNAME as build arguments to match host user
    BUILD_ARGS+=( "--build-arg=WORKDIR=$WORKDIR" )
    BUILD_ARGS+=( "--build-arg=UID=$USER_UID" )
    BUILD_ARGS+=( "--build-arg=GID=$USER_GID" )
    BUILD_ARGS+=( "--build-arg=USERNAME=$USERNAME" )
    BUILD_ARGS+=( "--build-arg=LANG=$LANG" )

    # Capture other useful environment variables (include truecolor/terminal hints)
    local extra_env=
    for var in TERM COLORTERM TERM_PROGRAM LANG LANGUAGE LC_ALL LC_CTYPE EDITOR VISUAL FULLNAME ; do
        [[ ${!var+x} ]] || continue
        local val="${!var}"
        if [ -n "$val" ] ; then
            # escape for safe `export VAR="val"` in .bashrc (preserve spaces, handle " \ $ `)
            local esc=${val//\\/\\\\}
            esc=${esc//\"/\\\"}
            esc=${esc//\$/\\\$}
            esc=${esc//\`/\\\`}
            [ -n "${extra_env}" ] && extra_env+=' '
            extra_env+="$var=\"$esc\""
        fi
    done
    echo "# extra_env: ${extra_env}"
    BUILD_ARGS+=( "--build-arg=EXTRA_ENV=${extra_env}" )

    # build a list of extra packages to install
    $XENABLE && EXTRA_PACKAGES+=( xauth )

    BUILD_ARGS+=( "--build-arg=EXTRA_PACKAGES=${EXTRA_PACKAGES[*]}" )
}

# Build did-NAME-base if NAME-base.Dockerfile exists and image is missing or --rebuild was given.
function ensure_base_image {
    [ -n "${BASE_DOCKERFILE:-}" ] || return 0
    [ -n "${BASE_FULLNAME:-}" ] || return 0

    local need_build=false
    if $REBUILD ; then
        need_build=true
    elif ! docker image inspect "${BASE_FULLNAME}" >/dev/null 2>&1 ; then
        need_build=true
    fi

    if ! $need_build ; then
        echo -e "# base image ${BRIGHT_GREEN}${BASE_FULLNAME}${RESET} already present"
        return 0
    fi

    echo -e "# building base image ${BRIGHT_YELLOW}${BASE_FULLNAME}${RESET} from ${BASE_DOCKERFILE}"
    local base_context
    base_context="$(dirname "${BASE_DOCKERFILE}")"
    ( set -x
    docker build \
        --build-arg "LANG=${LANG:-}" \
        --tag "${BASE_FULLNAME}" \
        --file "${BASE_DOCKERFILE}" \
        "${base_context}"
    )
}

function show_status {
    if [ -n "${BASE_FULLNAME:-}" ] ; then
        local base_images=( $( docker images --filter "reference=${BASE_FULLNAME}" --format '{{.ID}}' ) )
        if [ "${#base_images[@]}" -gt 0 ] ; then
            echo -e "${BASE_FULLNAME}: base  is ${BRIGHT_GREEN}built${RESET}:    ${BRIGHT_BLUE}${base_images[*]}${RESET}"
        else
            echo -e "${BASE_FULLNAME}: base  is ${BRIGHT_RED}not built${RESET}."
        fi
    fi

    local images=( $( docker images --filter "reference=${FULLNAME}" --format '{{.ID}}' ) )
    if [ "${#images[@]}" -gt 0 ] ; then
        echo -e "${FULLNAME}: image is ${BRIGHT_GREEN}built${RESET}:    ${BRIGHT_BLUE}${images[*]}${RESET}"
    else
        echo -e "${FULLNAME}: image is ${BRIGHT_RED}not built${RESET}."
    fi

    # Check if container is running (exact name match)
    local running=( $( docker ps --filter "name=^/${FULLNAME}$" --format '{{.ID}}' ) )
    if [ "${#running[@]}" -gt 0 ] ; then
        echo -e "${FULLNAME}: cntnr is ${BRIGHT_GREEN}running${RESET}:  ${BRIGHT_BLUE}${running[*]}${RESET}"
    fi

    local stopped=( $( docker ps --all --filter "name=^/${FULLNAME}$" --filter "status=exited" --format '{{.ID}}' ) )
    if [ "${#stopped[@]}" -gt 0 ] ; then
        echo -e "${FULLNAME}: cntnr is ${BRIGHT_YELLOW}stopped${RESET}:  ${BRIGHT_BLUE}${stopped[*]}${RESET}"
    fi

    if [ "${#running[@]}" -eq 0 ] && [ "${#stopped[@]}" -eq 0 ] ; then
        echo -e "${FULLNAME}: cntnr does ${BRIGHT_RED}not exist${RESET}."
    fi
}

# Function to display help
show_help() {
    cat <<END
${SELF} [ [options] <command> [command-options] ] [ , ... ]

    Options:

        -t <target>    - target to use, default: $(default_target)
        -n <name>      - name to use, default: ${PROJNAME}

        -d <dir>       - [build] local *.Dockerfile location, default:
                           ${LCL_DOCKERFILE_DIR}
        -D <dir>       - [build] system *.Dockerfile location, default:
                           ${SYS_DOCKERFILE_DIR}
        -p <pkg>       - [build] add this package to the build
        --rebuild      - [build] force rebuild of shared base image (did-NAME-base)
                         when NAME-base.Dockerfile exists

        -v <dir>       - [start] make this path also visible in container
        -N             - [start] enable host networking (reduces isolation)
        -E <port>      - [start] expose container port to host (host:container)
        -P             - [start] enable perf in docker
        -X             - [start] enable X forwarding (uses xhost +local:docker)

    Available commands:

        build          - create a dev image (auto-builds did-NAME-base if needed)
        remove         - remove a dev image
        start          - start the container (create or restart)
        stop           - stop the container (keeps it for restart)
        down           - stop and remove the container (alias: stop+rm)
        status         - check if built/running
        connect        - get a shell in the running container (alias: enter)
        run     <cmd>  - run a command in the running container

        , used to separate multiple commands

    Available targets:

END
    for t in $(available_targets); do
        printf "        %-20s   - %s\n" "$t" "$(dockerfile_for "$t")"
    done
    echo
}

function assert_no_more_arguments {
    local cmd="$1"
    local cnt="$2"
    [[ $cnt = 0 ]] || die "$cmd did not expect additional arguments, found $cnt"
}

function cmd_dispatch {
    local cmd="$1" ; shift

    case "$cmd" in
        help|--help|-h)
            show_help
            exit 0
            ;;
        *,*)
            re="^[a-z,]+$"
            [[ "$cmd" =~ $re ]] || die "bad"
            for x in ${cmd//,/ } ; do
                echo -e >&2 "# ${BRIGHT_YELLOW}$0 $x $*${RESET}"
                if ! "$SELFDIR/$SELF" "-t=$TARGET" "-n=$PROJNAME" "$x" "$@" ; then
                    die "failed: $0 $x $*"
                fi
            done
            exit 0
            ;;
        build)
            derive_target_project_variables
            ensure_base_image
            set_build_args
            ( set -x
            docker build "${@}" "${BUILD_ARGS[@]}" --tag "${FULLNAME}" --file "${DOCKERFILE}" .
            )
            return $?
            ;;
        rm|remove)
            assert_no_more_arguments $cmd $#
            derive_target_project_variables
            ( set -x
            docker image rm --force "${FULLNAME}"
            )
            return $?
            ;;
        up|start)
            assert_no_more_arguments $cmd $#
            derive_target_project_variables

            local running=( $( docker ps --filter "name=^/${FULLNAME}$" --format '{{.ID}}' ) )
            if [ "${#running[@]}" -gt 0 ] ; then
                echo "Container ${FULLNAME} is already running."
                return 0
            fi

            local stopped=( $( docker ps --all --filter "name=^/${FULLNAME}$" --filter "status=exited" --format '{{.ID}}' ) )
            if [ "${#stopped[@]}" -gt 0 ] ; then
                ( set -x
                docker start "${FULLNAME}"
                )
                return 0
            fi

            XARGS=( )
            if $XENABLE ; then
                XARGS+=( --env "DISPLAY=$DISPLAY" --volume "/tmp/.X11-unix:/tmp/.X11-unix" )
                ( set -x
                xhost +local:docker
                )
            fi

            for port in "${EXPOSE_PORTS[@]}" ; do
                local re="^[0-9]{1,5}:[0-9]{1,5}$"
                if ! [[ "$port" =~ $re ]] ; then
                    die "exposing ports requires <host-port>:<container-port> argument, not '$port'"
                fi
                XARGS+=( -p "$port" )
            done

            $NETENABLE && XARGS+=( --net=host )

            if $PERFENABLE ; then
                XARGS+=( --cap-add=PERFMON )
            fi

            for v in "${EXTRA_VOLUMES[@]}" ; do
                XARGS+=( --volume "$v:$v" )
            done
            # Forward terminal / truecolor hints at runtime (build-time EXTRA_ENV is stale after rebuild)
            for var in TERM COLORTERM TERM_PROGRAM KITTY_WINDOW_ID KITTY_LISTEN_ON GHOSTTY_RESOURCES_DIR WEZTERM_PANE ITERM_SESSION_ID WT_SESSION TERMINAL_EMULATOR LANG LANGUAGE LC_ALL LC_CTYPE; do
                if [[ ${!var+x} ]]; then
                    XARGS+=( --env "$var=${!var}" )
                fi
            done
            ( set -x
            docker run --detach --init --volume "$WORKDIR:$WORKDIR" --user "$USER_UID:$USER_GID" --name "${FULLNAME}" "${XARGS[@]}" "${FULLNAME}"
            )
            return $?
            ;;
        stop)
            assert_no_more_arguments $cmd $#
            derive_target_project_variables
            local container_ids=( $(docker ps --filter "name=^/${FULLNAME}$" --format='{{.ID}}') )
            if [ "${#container_ids[@]}" = 0 ]; then
                # also check if there's a stopped one to report
                local any=( $(docker ps --all --filter "name=^/${FULLNAME}$" --format='{{.ID}}') )
                if [ "${#any[@]}" = 0 ]; then
                    echo "Container ${FULLNAME} does not exist."
                else
                    echo "Container ${FULLNAME} is already stopped."
                fi
            else
                if $XENABLE ; then
                    ( set -x
                    xhost -local:docker
                    )
                fi
                for container_id in "${container_ids[@]}" ; do
                    ( set -x
                    docker stop "$container_id"
                    )
                done
            fi
            return 0
            ;;
        down)
            assert_no_more_arguments $cmd $#
            derive_target_project_variables
            local container_ids=( $(docker ps --all --filter "name=^/${FULLNAME}$" --format='{{.ID}}') )
            if [ "${#container_ids[@]}" = 0 ]; then
                echo "Container ${FULLNAME} does not exist."
            else
                if $XENABLE ; then
                    ( set -x
                    xhost -local:docker
                    )
                fi
                for container_id in "${container_ids[@]}" ; do
                    ( set -x
                    docker stop "$container_id" || true
                    )
                done
                for container_id in "${container_ids[@]}" ; do
                    ( set -x
                    docker rm "$container_id"
                    )
                done
            fi
            return 0
            ;;
        status)
            assert_no_more_arguments $cmd $#
            if [ -n "$TARGET" ] ; then
                derive_target_project_variables
                show_status
                exit $?
            fi
            for t in $(available_targets) ; do
                TARGET="$t"
                derive_target_project_variables
                show_status
                echo
            done
            return 0
            ;;
        connect|enter)
            assert_no_more_arguments $cmd $#
            derive_target_project_variables
            container_id="$(docker ps --filter "name=^/${FULLNAME}$" --format='{{.ID}}')"
            if [ -z "$container_id" ]; then
                local any="$(docker ps --all --filter "name=^/${FULLNAME}$" --format='{{.ID}}')"
                if [ -z "$any" ]; then
                    echo "Container ${FULLNAME} does not exist. Run 'did start' first."
                else
                    echo "Container ${FULLNAME} is not running (stopped). Run 'did start' first."
                fi
            else
                # Forward terminal hints to exec session as well
                EXEC_ENV=( )
                for var in TERM COLORTERM TERM_PROGRAM KITTY_WINDOW_ID KITTY_LISTEN_ON GHOSTTY_RESOURCES_DIR WEZTERM_PANE ITERM_SESSION_ID WT_SESSION TERMINAL_EMULATOR LANG LANGUAGE LC_ALL LC_CTYPE; do
                    if [[ ${!var+x} ]]; then
                        EXEC_ENV+=( --env "$var=${!var}" )
                    fi
                done
                ( set -x
                docker exec -it "${EXEC_ENV[@]}" "$container_id" bash -l
                )
            fi
            return 0
            ;;
        run|exec)
            derive_target_project_variables
            container_id="$(docker ps --filter "name=^/${FULLNAME}$" --format='{{.ID}}')"
            if [ -z "$container_id" ]; then
                local any="$(docker ps --all --filter "name=^/${FULLNAME}$" --format='{{.ID}}')"
                if [ -z "$any" ]; then
                    echo "Container ${FULLNAME} does not exist. Run 'did start' first."
                else
                    echo "Container ${FULLNAME} is not running (stopped). Run 'did start' first."
                fi
                exit 1
            elif [ $# -eq 0 ]; then
                echo "No command provided to run in the container."
                exit 1
            else
                # Preserve arguments with shell-escaping to avoid word-splitting hazards
                local esc_cmd
                printf -v esc_cmd '%q ' "$@"
                EXEC_ENV=( )
                for var in TERM COLORTERM TERM_PROGRAM KITTY_WINDOW_ID KITTY_LISTEN_ON GHOSTTY_RESOURCES_DIR WEZTERM_PANE ITERM_SESSION_ID WT_SESSION TERMINAL_EMULATOR LANG LANGUAGE LC_ALL LC_CTYPE; do
                    if [[ ${!var+x} ]]; then
                        EXEC_ENV+=( --env "$var=${!var}" )
                    fi
                done
                ( set -x
                docker exec --interactive --workdir "${WORKDIR}" "${EXEC_ENV[@]}" "$container_id" /bin/bash -l -c "$esc_cmd"
                )
            fi
            return 0
            ;;
        *)
            die "${0##*/} [ build | remove | start | stop | status | connect ] <target>"
            ;;
    esac
}

cmd=
accumulate=( )

while [ "${#@}" -gt 0 ] ; do
    arg="$1" ; shift

    if [ "$arg" = , ] ; then
        cmd_dispatch "$cmd" "${accumulate[@]}" || die "failed: $cmd ${accumulate[*]}"
        cmd=
        accumulate=( )
        continue
    fi

    if [ -n "$cmd" ] ; then
        accumulate+=( "$arg" )
        continue
    fi

    case "$arg" in
        build|rm|remove|up|start|down|stop|status|connect|enter|run|exec)
            cmd="$arg"
            ;;
        -t=*) TARGET="${arg#-t=}" ;;
        -t)   TARGET="$1" ; shift ;;

        -n=*) PROJNAME="${arg#-n=}" ;;
        -n)   PROJNAME="$1" ; shift ;;

        -d=*) LCL_DOCKERFILE_DIR="${arg#-d=}" ;;
        -d)   LCL_DOCKERFILE_DIR="$1" ; shift ;;

        -D=*) SYS_DOCKERFILE_DIR="${arg#-D=}" ;;
        -D)   SYS_DOCKERFILE_DIR="$1" ; shift ;;

        -p=*) EXTRA_PACKAGES+=( "${arg#-p=}" ) ;;
        -p)   EXTRA_PACKAGES+=( "$1" ) ; shift ;;

        -v=*) EXTRA_VOLUMES+=( "${arg#-v=}" ) ;;
        -v)   EXTRA_VOLUMES+=( "$1" ) ; shift ;;

        -E=*) EXPOSE_PORTS+=( "${arg#-E=}" ) ;;
        -E)   EXPOSE_PORTS+=( "$1" ) ; shift ;;

        -N)   NETENABLE=true ;;
        -X)   XENABLE=true ;;
        --rebuild|--rebulid) REBUILD=true ;;

        -P)
            case "$( sysctl -n kernel.perf_event_paranoid )" in
                -1) ;;
                *) warn "for perf to work in container, run the following from the host:\n\n\t" \
                    "sudo sysctl -w kernel.perf_event_paranoid=-1\n"
            esac
            PERFENABLE=true
            ;;

        help|--help|-h)
            show_help
            exit 0
            ;;
        *)
            die "unexpected option: $arg"
            ;;
    esac
done

if [ -n "$cmd" ] ; then
    cmd_dispatch "$cmd" "${accumulate[@]}" || die "failed: $cmd ${accumulate[*]}"
fi
